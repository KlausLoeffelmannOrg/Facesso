<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ActiveDev.Controls</RootNamespace>
    <MyType>Windows</MyType>
    <OptionStrict>On</OptionStrict>
    <AssemblyOriginatorKeyFile>ActiveDev.pfx</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DocumentationFile>ADNullableValueControls.xml</DocumentationFile>
    <NoWarn>42016,42017,42018,42019,42032,42353,42354,42355</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineDebug>false</DefineDebug>
    <OutputPath>bin\</OutputPath>
    <DocumentationFile>ADUnifiedValueControls.xml</DocumentationFile>
    <NoWarn>42016,42017,42018,42019,42032,42353,42354,42355</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DocumentationFile>ADNullableValueControls.xml</DocumentationFile>
    <NoWarn>42016,42017,42018,42019,42032,42353,42354,42355</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\Release\</OutputPath>
    <DocumentationFile>ADUnifiedValueControls.xml</DocumentationFile>
    <NoWarn>42016,42017,42018,42019,42032,42353,42354,42355</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DocumentationFile>ADNullableValueControls.xml</DocumentationFile>
    <NoWarn>42016,42017,42018,42019,42032,42353,42354,42355</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DocumentationFile>ADUnifiedValueControls.xml</DocumentationFile>
    <NoWarn>42016,42017,42018,42019,42032,42353,42354,42355</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Accessibility" />
    <Reference Include="System.Design" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="ADNullableValueControls\ADNullableIntBoxBase.vb">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="ADNullableValueControls\ADNullableControlTemplate.vb">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="ADNullableValueControls\ADNullableDateTimeBox.vb">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="ADNullableValueControls\ADNullableDoubleBox.vb">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="ADNullableValueControls\ADNullableTextBox.vb">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="ADNullableValueControls\ADNullableCheckBox.vb">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="ADNullableValueControls\ADNullableComboBox.vb">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="My Project\MyApplication.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>MyApplication.myapp</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="My Project\MyResources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>MyResources.resx</DependentUpon>
    </Compile>
    <Compile Update="My Project\MySettings.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>MySettings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="ActiveDev.pfx" />
    <None Update="My Project\MyApplication.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>MyApplication.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <AppDesigner Include="My Project\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ActiveDevelop.SqlTools\ActiveDevelop.SqlTools.vbproj" />
    <ProjectReference Include="..\ADDataTypes\ADDataTypes.vbproj" />
  </ItemGroup>
</Project>
